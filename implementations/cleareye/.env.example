# ClearEye Environment Variables
# Copy this file to .env and fill in your values

# Required
ANTHROPIC_API_KEY=sk-ant-...

# Optional: Flask session secret (auto-generated if not set)
SECRET_KEY=change-me-in-production

# Optional: Stripe (for paid subscriptions)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_OPERATOR=price_...
STRIPE_PRICE_PROFESSIONAL=price_...
STRIPE_PRICE_TEAM=price_...

# Optional: Email (Gmail app password for magic-link auth and alerts)
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Optional: RentCast for live rent comps
RENTCAST_API_KEY=...

# App URL (used for share links and magic-link emails)
APP_URL=https://your-app.onrender.com
